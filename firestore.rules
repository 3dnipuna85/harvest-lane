rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can read and write only their own farm.
    match /farms/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.data.state is string);
    }
    // A public card for each player (name, photo, level and a copy of the farm to visit).
    // Any signed-in player can read it; only its owner can write it.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Friends: accepting an invite writes the link on both players, so either one may write it.
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fid);
      }
      // Friend requests sent by email: the sender writes one; the receiver reads it, then accepts or declines.
      match /invites/{from} {
        allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
        allow create, update: if request.auth != null && request.auth.uid == from && from != uid;
      }
    }
    // Invites to an email that doesn't play yet: anyone signed in may leave one under their own uid;
    // whoever signs in with that email reads them (turning them into friend requests) and clears them.
    match /emailInvites/{email}/from/{from} {
      allow create, update: if request.auth != null && request.auth.uid == from;
      allow read, delete: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email;
    }
    // Email to player lookup for "invite by email". Look up one address at a time (no listing);
    // only the signed-in owner of that address can point it at their own account.
    match /emails/{email} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == email && request.resource.data.uid == request.auth.uid;
    }
  }
}
